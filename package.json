{
  "name": "dropflash-optical-transfer",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "description": "Experimental offline-capable screen-to-camera file transfer web app",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "tsx --test src/engine/protocol.test.ts src/engine/decoder.test.ts src/engine/transfer.test.ts",
    "check": "npm run lint && npm test && npm run build",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
